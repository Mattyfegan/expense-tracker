{
	"name": "@expense-tracker/web",
	"version": "1.0.0",
	"type": "module",
	"private": true,
	"scripts": {
		"clean": "rm -rf .next",
		"dev": "next dev",
		"build": "next build",
		"prepare:standalone": "node ./scripts/prepare-standalone.mjs",
		"build:deploy": "pnpm build && pnpm prepare:standalone",
		"start": "next start",
		"start:deploy": "node .next/standalone/apps/web/server.js",
		"test": "node ../../scripts/run-tests.mjs src --exclude=integration.test.js",
		"lint": "biome format --write && biome check --write"
	},
	"dependencies": {
		"@auth/prisma-adapter": "^2.11.3",
		"@aws-sdk/client-s3": "^3.1140.0",
		"@aws-sdk/s3-request-presigner": "^3.1140.0",
		"@expense-tracker/db": "workspace:*",
		"@expense-tracker/ui": "workspace:*",
		"@prisma/client": "^7.10.0",
		"@usequark/quark-core": "^2.0.0",
		"ioredis": "^6.0.0",
		"jose": "^6.2.12",
		"lucide-react": "^1.67.0",
		"next": "16.3.8",
		"next-auth": "5.0.0-beta.32",
		"pg": "^8.23.0",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"recharts": "^3.10.1",
		"rrweb": "2.1.6",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@expense-tracker/config": "workspace:*",
		"@tailwindcss/postcss": "^4.3.3",
		"@types/node": "^26.6.6",
		"tailwindcss": "^4.3.3"
	}
}
